APP_PORT=8080
DATABASE_URL=postgres://zkdonation:zkdonation@127.0.0.1:5432/zk_donation?sslmode=disable
JWT_SECRET=change-me-in-production-use-long-random-string
BOOTSTRAP_TOKEN=change-me-bootstrap-demo
# Rate limit login gagal per IP (in-memory, satu proses backend)
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MIN=15
PAILLIER_KEY_PATH=keys/paillier.json
PAILLIER_KEY_SIZE=2048
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rekonsiliasi donasi pending otomatis (detik); 0 = mati
DONATION_PENDING_RECONCILE_SEC=120
